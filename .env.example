# Copy to .env and fill in. All of these are public addresses (no secrets):
# access is controlled by sign-in tokens and the database's security rules.
# After `neon deploy` (in neon/), the values are in neon/.env.local:
#   NEON_AUTH_BASE_URL, NEON_DATA_API_URL and the NEON_FUNCTION_*_BASE_URL
# lines. Never copy anything else from that file — it holds secrets.
NEON_AUTH_URL=https://ep-YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_DATA_API_URL=https://ep-YOUR-ENDPOINT.apirest.REGION.aws.neon.tech/neondb/rest/v1
NEON_MEDIA_URL=https://YOUR-BRANCH-media.compute.REGION.aws.neon.tech
NEON_PUSH_URL=https://YOUR-BRANCH-push.compute.REGION.aws.neon.tech
NEON_AUTH_RETURN_URL=https://YOUR-BRANCH-authbounce.compute.REGION.aws.neon.tech
